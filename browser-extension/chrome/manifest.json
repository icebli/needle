{
  "manifest_version": 3,
  "name": "Needle",
  "version": "0.2.8",
  "description": "Send the current recording to Needle and optionally add the cleaned local file to Spotify.",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "scripting",
    "storage",
    "tabs"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Download with Needle",
    "default_popup": "popup.html",
    "default_icon": { "48": "icons/needle-48.png", "96": "icons/needle-96.png" }
  },
  "icons": { "48": "icons/needle-48.png", "96": "icons/needle-96.png" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtu.be/*", "*://*.soundcloud.com/*"],
      "js": ["browser-compat.js", "context-capture.js"],
      "run_at": "document_start"
    }
  ]
}
